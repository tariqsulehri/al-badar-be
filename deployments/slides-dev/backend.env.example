PORT=3500
NODE_ENV=development

# MongoDB physically installed on host VM (167.86.122.141)
DB=mongodb://host.docker.internal:27017/abdata_dev

# JWT Secret Key
NODE_SECRET_KEY=dev_jwt_secret_slides_key_local_1234567890_development
JWT_EXPIRES_IN=24h

# Base URL & Uploads
BASE_URL=http://167.86.122.141:3501
BASE_IMAGES_PATH=http://167.86.122.141:3501/uploads/slides/images

# Allowed CORS Origins
CORS_ORIGINS=http://167.86.122.141:3001,http://167.86.122.141:3501,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
