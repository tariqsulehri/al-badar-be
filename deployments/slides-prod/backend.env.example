# ==============================================================================
# Slides Backend Environment Template - PRODUCTION
# ==============================================================================
PORT=3500
NODE_ENV=production

# MongoDB physically installed on host VM (167.86.122.141)
DB=mongodb://host.docker.internal:27017/abdata

# JWT Secret Key
NODE_SECRET_KEY=replace_with_a_secure_random_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# Base URL & Uploads
BASE_URL=http://167.86.122.141
BASE_IMAGES_PATH=http://167.86.122.141/uploads/slides/images

# Allowed CORS Origins
CORS_ORIGINS=http://167.86.122.141,http://167.86.122.141:3000,http://localhost:3000
