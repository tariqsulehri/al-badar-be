# Copy to .env and fill in. Never commit real values.
PORT=3500
NODE_ENV=development

# MongoDB connection string (required)
DB=mongodb://localhost:27017/abdata

# JWT signing secret (required). Generate with: openssl rand -hex 48
NODE_SECRET_KEY=
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Public URL of this API, used to build uploaded image URLs
BASE_URL=http://localhost:3500

# Login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10
